# Optional. Copy to .env to change any of these; the defaults work without a .env file.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

WAREHOUSE_DB=warehouse
WAREHOUSE_USER=dw
WAREHOUSE_PASSWORD=dw

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8082

METABASE_ADMIN_EMAIL=admin@citibike.local
METABASE_ADMIN_PASSWORD=Citibike-Admin-2025

# months the DAG backfills, one run per month
PIPELINE_START_MONTH=2025-01
PIPELINE_END_MONTH=2025-06

# set to local[*] to run Spark inside the Airflow container instead of on the cluster
SPARK_MASTER_URL=spark://spark-master:7077
